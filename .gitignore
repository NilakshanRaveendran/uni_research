# Web app
# Every dub writes a job folder; none of it is tracked any more. The result.json files already
# committed (cited as evidence in docs/viva) stay tracked, since ignore rules only affect new files.
webapp/jobs/
webapp/.runtime/
webapp/frontend/node_modules/
webapp/frontend/.next/
webapp/frontend/next-env.d.ts
webapp/frontend/tsconfig.tsbuildinfo

# Fine-tuned model weights are regenerable from finetune.py (~300 MB each) -- keep the
# curves, comparison JSONs and hypotheses, which are the actual results.
artifacts/finetune/best-*/

# LaTeX build products. The .tex sources, figures and numbers.json are tracked; the compiled
# PDFs and the auxiliary files pdflatex/bibtex regenerate are not.
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.lof
thesis/*.lot
thesis/*.pdf
!thesis/UWU_CST_2026_dissertation.pdf
journal/*.aux
journal/*.bbl
journal/*.blg
journal/*.log
journal/*.out
journal/*.pdf
!journal/IEEE_manuscript.pdf

# Large intermediate outputs - regenerable from src/, excluded 2026-09-02.
# artifacts/ladder is 882 MB / 5563 files; artifacts/contours is 20 MB / 2893 files.
# The summary CSVs, history JSONs and plots derived from them ARE tracked.
artifacts/ladder/
artifacts/contours/

# Local agent/editor state
.claude/
