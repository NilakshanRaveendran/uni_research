      "final_duration": 4.72,
      "scale_applied": 0.8848893888263967,
      "clamped": false,
      "error": ""
    },
    {
      "index": 1,
      "start": 4.72,
      "end": 7.92,
      "source_text": "Nos pasamos la vida preocup\u00e1ndonos por lo que no importa,",
      "translated_text": "We spend our lives worrying about what doesn't matter.",
      "original_duration": 3.2,
      "raw_tts_duration": 3.3393333333333333,
      "final_duration": 3.2,
      "scale_applied": 0.9582751048113397,
      "clamped": false,
      "error": ""
    },
    {
      "index": 2,
      "start": 7.92,
      "end": 12.6,
      "source_text": "desperdiciando d\u00edas preciosos por rencores, enfados, o por lo que otros",
      "translated_text": "wasting precious days for grudges, angers, or so many others",
      "original_duration": 4.68,
      "raw_tts_duration": 4.779333333333334,
      "final_duration": 4.68,
      "scale_applied": 0.9792160691867763,
      "clamped": false,
      "error": ""
    },
    {
      "index": 3,
      "start": 12.6,
      "end": 14.280000000000001,
      "source_text": "piensen de nosotros.",
      "translated_text": "think about us.",
      "original_duration": 1.6800000000000015,
      "raw_tts_duration": 2.3153333333333332,
      "final_duration": 1.685,
      "scale_applied": 0.7255974661675791,
      "clamped": false,
      "error": ""
    },
    {
      "index": 4,
      "start": 14.280000000000001,
      "end": 16.64,
      "source_text": "Pero, \u00bfde qu\u00e9 sirve?",
      "translated_text": "But what's the use?",
      "original_duration": 2.3599999999999994,
      "raw_tts_duration": 1.942,
      "final_duration": 2.365,
      "scale_applied": 1.2152420185375898,
      "clamped": false,
      "error": ""
    },
    {
      "index": 5,
      "start": 16.64,
      "end": 18.400000000000002,
      "source_text": "La vida es tan fr\u00e1gil",
      "translated_text": "Life is so fragile.",
      "original_duration": 1.7600000000000016,
      "raw_tts_duration": 2.3153333333333332,
      "final_duration": 1.765,
      "scale_applied": 0.7601497264612734,
      "clamped": false,
      "error": ""
    },
    {
      "index": 6,
      "start": 18.400000000000002,
      "end": 21.68,
      "source_text": "y cada segundo que pasa, no vuelve.",
      "translated_text": "And every second that happens, he doesn't come back.",
      "original_duration": 3.2799999999999976,
      "raw_tts_duration": 2.731333333333333,
      "final_duration": 3.285,
      "scale_applied": 1.2008786917256522,
      "clamped": false,
      "error": ""
    },
    {
      "index": 7,
      "start": 21.68,
      "end": 26.36,
      "source_text": "Hoy quiero recordarte algo que quiz\u00e1s ya sabes, pero a veces olvidamos.",
      "translated_text": "I want to remind you today something that maybe you know, but sometimes we forget.",
      "original_duration": 4.68,
      "raw_tts_duration": 6.678,
      "final_duration": 4.68,
      "scale_applied": 0.7008086253369272,
      "clamped": false,
      "error": ""
    },
    {
      "index": 8,
      "start": 26.36,
      "end": 28.04,
      "source_text": "S\u00e9 feliz.",
      "translated_text": "Be happy.",
      "original_duration": 1.6799999999999997,
